{
  "expo": {
    "name": "Rize Haber",
    "slug": "rize-haber",
    "version": "1.7.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kidmandesign.rizehaber"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1B6B3A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kidmandesign.rizehaber",
      "versionCode": 14,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      "expo-background-task",
      [
        "expo-notifications",
        {
          "color": "#1B6B3A",
          "defaultChannel": "yeni-haberler"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "# WorkManager (expo-background-task) Room veritabanini yansima ile olusturur;\n# R8 kurucuyu silerse uygulama acilista coker (NoSuchMethodException WorkDatabase_Impl.<init>).\n-keep class * extends androidx.room.RoomDatabase { <init>(); }\n-keep class androidx.work.impl.** { *; }\n-keep class * extends androidx.work.ListenableWorker { <init>(...); }"
          }
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 170,
          "resizeMode": "contain",
          "backgroundColor": "#1B6B3A",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0E4D2A"
          }
        }
      ],
      "./plugins/withReleaseSigning",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ]
    ]
  }
}
