<?xml version="1.0" encoding="utf-8"?>
<!-- Son Haberler widget'ı: başlık + yüksekliğe göre 1–4 haber satırı. Her satır kendi haberini açar. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

  <ImageView
      android:id="@+id/rw_bg"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:importantForAccessibility="no"
      android:scaleType="fitXY"
      android:src="@drawable/rw_bg" />

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:orientation="vertical"
      android:paddingStart="@dimen/rw_padding"
      android:paddingTop="12dp"
      android:paddingEnd="@dimen/rw_padding"
      android:paddingBottom="10dp">

    <LinearLayout
        android:id="@+id/rw_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="24dp"
        android:orientation="horizontal">

      <ImageView android:id="@+id/rw_header_icon" style="@style/RwHeaderIcon" android:src="@drawable/rw_ic_news" />
      <TextView android:id="@+id/rw_title" style="@style/RwHeaderTitle" android:text="Rize Haber" />
      <TextView android:id="@+id/rw_updated" style="@style/RwHeaderMeta" android:text="14:05" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rw_rows"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="2dp"
        android:orientation="vertical">

    <LinearLayout android:id="@+id/rw_n0" style="@style/RwNewsRow">
      <TextView android:id="@+id/rw_n0_title" style="@style/RwNewsTitle" android:text="Rize’de çay hasadı için yeni dönem: kota kaldırıldı" />
      <TextView android:id="@+id/rw_n0_meta" style="@style/RwNewsMeta" android:text="Rize Gazetesi · 12 dk önce" />
    </LinearLayout>
    <ImageView android:id="@+id/rw_n1_div" style="@style/RwDivider" />
    <LinearLayout android:id="@+id/rw_n1" style="@style/RwNewsRow">
      <TextView android:id="@+id/rw_n1_title" style="@style/RwNewsTitle" android:text="Ovit Tüneli kış boyunca açık kalacak" />
      <TextView android:id="@+id/rw_n1_meta" style="@style/RwNewsMeta" android:text="Yeşil Rize · 1 sa önce" />
    </LinearLayout>
    <ImageView android:id="@+id/rw_n2_div" style="@style/RwDivider" />
    <LinearLayout android:id="@+id/rw_n2" style="@style/RwNewsRow">
      <TextView android:id="@+id/rw_n2_title" style="@style/RwNewsTitle" android:text="Ayder’de kar kalınlığı 40 santimetreyi buldu" />
      <TextView android:id="@+id/rw_n2_meta" style="@style/RwNewsMeta" android:text="Rize Haber · 3 sa önce" />
    </LinearLayout>
    <ImageView android:id="@+id/rw_n3_div" style="@style/RwDivider" />
    <LinearLayout android:id="@+id/rw_n3" style="@style/RwNewsRow">
      <TextView android:id="@+id/rw_n3_title" style="@style/RwNewsTitle" android:text="Çaykur Rizespor hazırlıklarını sürdürüyor" />
      <TextView android:id="@+id/rw_n3_meta" style="@style/RwNewsMeta" android:text="Spor · 5 sa önce" />
    </LinearLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/rw_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/rw_open_app"
        android:textColor="#5E6B63"
        android:textSize="13sp"
        android:visibility="gone" />
  </LinearLayout>
</FrameLayout>
